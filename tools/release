#!/usr/bin/env python3
"""Build the deployable backend zip and scan it (R32).
   tools/release                 → dist/sunrise-backend-<version>.zip  (then scans it)
   tools/release --scan FILE.zip → scan any zip
   tools/release --scan-tree     → scan the files git would commit (used by the pre-commit hook)
   A release never contains app/config.php, tools/devrouter.php, sessions, logs, uploads or backups, and must contain
   the storage/*/.htaccess guards. No file may contain something that looks like a real API key or private key."""
import os, re, sys, zipfile, subprocess, fnmatch
ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
BACKEND = os.path.join(ROOT, 'backend')
EXCLUDE = ['app/config.php', 'tools/devrouter.php', 'tools/*', 'storage/*/*', 'storage/*', '*.log', '*.sig', '.DS_Store', '*/__pycache__/*', '*.sql', '*.sql.gz']
KEEP = ['storage/.htaccess', 'storage/*/.htaccess', 'storage/*/index.html']
GUARDS = ['storage/.htaccess', 'storage/uploads/.htaccess', 'storage/logs/.htaccess', 'storage/cache/.htaccess', 'storage/backups/.htaccess', 'app/.htaccess', '.htaccess']
SECRETS = [(r'pfx_[A-Za-z0-9]{16,}', 'pfx_ key'), (r'\bsk-(?:ant-|proj-|live_|test_)?[A-Za-z0-9_\-]{24,}', 'sk- key'), (r'\bAKIA[0-9A-Z]{16}\b', 'AWS key'),
           (r'\bxox[baprs]-[A-Za-z0-9-]{10,}', 'Slack token'), (r'\bghp_[A-Za-z0-9]{30,}', 'GitHub token'), (r'\bAIza[0-9A-Za-z_\-]{35}\b', 'Google key'),
           (r'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----', 'private key'), (r"'app_key'\s*=>\s*'base64:(?!CHANGE-ME)[A-Za-z0-9+/=]{40,}'", 'app_key'),
           (r'\b(?:consumer_secret|passkey|api_key|secret_key)\s*[=:]\s*["\'][A-Za-z0-9+/=_\-]{24,}["\']', 'hard-coded secret')]

def version():
    m = re.search(r"APP_VERSION'?\s*[,=]\s*'([^']+)'", open(os.path.join(BACKEND, 'app', 'bootstrap.php')).read()); return m.group(1) if m else 'dev'

def excluded(rel):
    if any(fnmatch.fnmatch(rel, k) for k in KEEP): return False
    return any(fnmatch.fnmatch(rel, x) for x in EXCLUDE)

def build(out_dir):
    os.makedirs(out_dir, exist_ok=True); path = os.path.join(out_dir, 'sunrise-backend-%s.zip' % version())
    with zipfile.ZipFile(path, 'w', zipfile.ZIP_DEFLATED) as z:
        for d, dirs, files in os.walk(BACKEND):
            dirs[:] = [x for x in dirs if x not in ('__pycache__', '.git', 'node_modules')]
            for f in files:
                full = os.path.join(d, f); rel = os.path.relpath(full, BACKEND).replace(os.sep, '/')
                if not excluded(rel): z.write(full, 'backend/' + rel)
    return path

def scan_text(name, data, problems):
    if name.endswith(('.png', '.jpg', '.webp', '.woff2', '.ico', '.gif', '.zip', '.gz')): return
    text = data.decode('utf-8', 'replace')
    for rx, label in SECRETS:
        m = re.search(rx, text)
        if m: problems.append('%s: looks like a %s (%s…)' % (name, label, m.group(0)[:12]))

def scan_zip(path):
    problems = []
    with zipfile.ZipFile(path) as z:
        names = z.namelist(); short = [n.split('backend/', 1)[-1] for n in names]
        if any(n.endswith('app/config.php') for n in names): problems.append('app/config.php is in the zip')
        if any(n.endswith('tools/devrouter.php') for n in names): problems.append('tools/devrouter.php is in the zip')
        for g in GUARDS:
            if g not in short: problems.append('missing guard ' + g)
        for n in names:
            if re.search(r'storage/(uploads|logs|backups|cache)/(?!\.htaccess$|index\.html$).+', n): problems.append('runtime file in zip: ' + n)
            if n.endswith(('.env', '.sql', '.sql.gz', '.log')): problems.append('should not ship: ' + n)
            scan_text(n, z.read(n), problems)
    return problems

def scan_tree():
    try: files = subprocess.run(['git', 'ls-files', '-co', '--exclude-standard'], cwd=ROOT, capture_output=True, text=True, check=True).stdout.split('\n')
    except Exception: files = [os.path.relpath(os.path.join(d, f), ROOT) for d, _, fs in os.walk(ROOT) for f in fs if '/.git/' not in d]
    problems = []
    for f in filter(None, files):
        if f == 'backend/app/config.php': problems.append('backend/app/config.php would be committed (it is in .gitignore — check git add -f)')
        p = os.path.join(ROOT, f)
        if os.path.isfile(p) and os.path.getsize(p) < 3_000_000 and not f.startswith(('screenshots/', 'dist/')): scan_text(f, open(p, 'rb').read(), problems)
    return problems

if __name__ == '__main__':
    a = sys.argv[1:]
    if a[:1] == ['--scan']: probs = scan_zip(a[1]); target = a[1]
    elif a[:1] == ['--scan-tree']: probs = scan_tree(); target = 'working tree'
    else:
        out = a[a.index('--out') + 1] if '--out' in a else os.path.join(ROOT, 'dist')
        target = build(out); probs = scan_zip(target); print('built', os.path.relpath(target, ROOT), '(%d KB)' % (os.path.getsize(target) // 1024))
    for p in probs: print('  FAIL', p)
    print('release scan of %s: %s' % (target if not target.startswith(ROOT) else os.path.relpath(target, ROOT), 'clean' if not probs else '%d problems' % len(probs)))
    sys.exit(1 if probs else 0)
