#!/usr/bin/env python3
"""
sync-rules: regenerate every AI-tool entry file from RULES.md so they never drift apart.

  tools/sync-rules          write all entry files
  tools/sync-rules --check  exit 1 if any entry file differs from what RULES.md would generate (used by check-all / CI)

Generated: AGENTS.md · CLAUDE.md · GEMINI.md · .github/copilot-instructions.md · .windsurfrules · .clinerules ·
           .cursor/rules/project.mdc (alwaysApply: true) · the rules block at the top of SKILL.md ·
           skills/sunrise-dashboard-ui/{SKILL.md,RULES.md}
"""
import pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
RULES = ROOT / 'RULES.md'
BEGIN, END = '<!-- RULES:BEGIN (generated by tools/sync-rules from RULES.md, do not edit) -->', '<!-- RULES:END -->'

START = ('**Start of every task:** Read RULES.md fully before writing code. Restate the 5 rules most relevant to this '
         'task. If a rule conflicts with the request, ask before breaking it.')
FINISH = ('**End of every task:** Run `tools/check-all` and paste the result. Do not say "done" while any check fails.')


def parse():
    text = RULES.read_text(encoding='utf-8')
    rules, cur = {}, None
    for line in text.splitlines():
        m = re.match(r'^- \*\*(R\d+)\*\* (.*)', line)
        if m:
            cur = m.group(1); rules[cur] = m.group(2).strip(); continue
        if cur and line.startswith('  ') and line.strip():
            rules[cur] += ' ' + line.strip(); continue
        cur = None
    top = re.search(r'## Top 10[^\n]*\n(.+)', text)
    ids = re.findall(r'R\d+', top.group(1)) if top else list(rules)[:10]
    return rules, ids


def strip_check(t):
    return re.sub(r'\s*\*\(check:[^)]*\)\*\s*$', '', t).strip()


def body(title, rules, ids, intro=''):
    lines = [f'# {title}', '', '> Generated by `tools/sync-rules` from **RULES.md**. Do not edit this file; edit RULES.md.', '']
    if intro: lines += [intro, '']
    lines += [START, '', FINISH, '', '## Top 10 rules (all 33 rules: RULES.md)']
    for i, rid in enumerate(ids, 1):
        lines.append(f'{i}. **{rid}** {strip_check(rules[rid])}')
    lines += ['', '## Where things are',
              '- `RULES.md`: every rule, each with the check that proves it.',
              '- `SKILL.md`: the UI kit reference (exact markup for every component).',
              '- `backend/README.md`: the PHP + MySQL kit (start a project in 5 lines, file map, how to add a page).',
              '- `tools/check-all`: runs every check; also runs as a git pre-commit hook and in GitHub Actions.', '']
    return '\n'.join(lines)


def outputs():
    rules, ids = parse()
    out = {}
    out['AGENTS.md'] = body('Agent instructions (Codex, ChatGPT and other agents)', rules, ids)
    out['CLAUDE.md'] = body('Claude instructions', rules, ids, 'The Claude skill is `SKILL.md` (also in `skills/sunrise-dashboard-ui/`).')
    out['GEMINI.md'] = body('Gemini instructions', rules, ids)
    out['.github/copilot-instructions.md'] = body('Copilot instructions', rules, ids)
    out['.windsurfrules'] = body('Windsurf rules', rules, ids)
    out['.clinerules'] = body('Cline rules', rules, ids)
    out['.cursor/rules/project.mdc'] = ('---\ndescription: Sunrise UI + PHP kit rules (generated from RULES.md)\nglobs:\nalwaysApply: true\n---\n'
                                        + body('Cursor project rules', rules, ids))
    # SKILL.md: replace only the generated block after the front matter
    skill = (ROOT / 'SKILL.md').read_text(encoding='utf-8')
    block = BEGIN + '\n' + body('Rules first', rules, ids).replace('# Rules first', '## Rules first (read before anything below)', 1) + END
    if BEGIN in skill:
        skill = re.sub(re.escape(BEGIN) + r'[\s\S]*?' + re.escape(END), lambda m: block, skill)
    else:
        fm = re.match(r'^---\n[\s\S]*?\n---\n', skill)
        cut = fm.end() if fm else 0
        skill = skill[:cut] + '\n' + block + '\n' + skill[cut:]
    out['SKILL.md'] = skill
    out['skills/sunrise-dashboard-ui/SKILL.md'] = skill
    out['skills/sunrise-dashboard-ui/RULES.md'] = RULES.read_text(encoding='utf-8')
    return out


def main():
    check = '--check' in sys.argv
    drift = []
    for rel, content in outputs().items():
        p = ROOT / rel
        old = p.read_text(encoding='utf-8') if p.exists() else None
        if old != content:
            if check: drift.append(rel)
            else:
                p.parent.mkdir(parents=True, exist_ok=True); p.write_text(content, encoding='utf-8'); print('wrote', rel)
    if check:
        if drift: print('OUT OF SYNC (run tools/sync-rules):', ', '.join(drift)); sys.exit(1)
        print('rules in sync (' + str(len(outputs())) + ' files)')


if __name__ == '__main__':
    main()
